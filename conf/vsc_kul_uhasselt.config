// Institutional config for the VSC KU Leuven / UHasselt Tier-2 HPC.
//
// All custom Groovy that used to live in this file has been moved into the
// in-tree `nf-vsc-kul-uhasselt` plugin (plugins/nf-vsc-kul-uhasselt/), so this
// config is valid under Nextflow v26+ strict syntax.
//
// The plugin reads VSC_SCRATCH, SLURM_ACCOUNT, and VSC_DEDICATED_QUEUES from
// the environment. See docs/vsc_kul_uhasselt.md for the required env setup.

plugins {
    id 'nf-vsc-kul-uhasselt@0.1.0'
}

executor {
    submitRateLimit = '50/1min'
    queueSize       = 50
    exitReadTimeout = '10min'
}

process {
    executor      = 'vsc-kul-uhasselt'
    stageInMode   = 'symlink'
    stageOutMode  = 'rsync'
    errorStrategy = 'retry'
    maxRetries    = 3
}

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = "$VSC_SCRATCH/.singularity"
    pullTimeout = '30 min'
}

env {
    APPTAINER_TMPDIR   = "$VSC_SCRATCH/.apptainer/tmp"
    APPTAINER_CACHEDIR = "$VSC_SCRATCH/.apptainer/cache"
}

aws.client.maxErrorRetry = 3

// Optional CO2 footprint reporting; only active when -plugins nf-co2footprint@1.0.0
// is on the CLI. Filenames no longer include a timestamp — newer nf-co2footprint
// versions disambiguate runs themselves.
co2footprint {
    traceFile   = 'pipeline_info/co2footprint_trace.txt'
    summaryFile = 'pipeline_info/co2footprint_summary.txt'
    reportFile  = 'pipeline_info/co2footprint_report.html'
    location    = 'BE'
    machineType = 'compute cluster'
}

params {
    config_profile_contact = 'GitHub: @Joon-Klaps - Email: joon.klaps@kuleuven.be'
    config_profile_url     = 'https://docs.vscentrum.be/en/latest/index.html'
}

/*
 * Profiles
 * ========
 * Each profile sets `process.ext.vscCluster`, which the plugin executor reads
 * to pick the right cluster / partition / account / module-load logic.
 * Resource limits come from
 *   https://docs.vscentrum.be/leuven/tier2_hardware/genius_hardware.html
 *   https://docs.vscentrum.be/leuven/tier2_hardware/wice_hardware.html
 */
profiles {
    genius {
        params.config_profile_description = 'genius profile for use on the genius cluster of the VSC HPC.'

        process {
            // 768 - 65 so 65GB for overhead, max is 720000MB
            resourceLimits = [ memory: 703.GB, cpus: 36, time: 168.h ]
            ext.vscCluster = 'genius'

            withLabel: '.*gpu.*' {
                resourceLimits         = [ memory: 703.GB, cpus: 36, time: 168.h ]
                ext.vscCluster         = 'genius_gpu'
                apptainer.runOptions   = '--containall --cleanenv --nv'
                singularity.runOptions = '--containall --cleanenv --nv'
            }
        }
    }

    genius_gpu {
        params.config_profile_description = 'genius_gpu profile for use on the genius cluster of the VSC HPC.'
        apptainer.runOptions              = '--containall --cleanenv --nv'
        singularity.runOptions            = '--containall --cleanenv --nv'

        process {
            resourceLimits = [ memory: 703.GB, cpus: 36, time: 168.h ]
            ext.vscCluster = 'genius_gpu'
        }
    }

    wice {
        params.config_profile_description = 'wice profile for use on the Wice cluster of the VSC HPC.'

        process {
            // max is 2016000
            resourceLimits = [ memory: 1968.GB, cpus: 72, time: 168.h ]
            ext.vscCluster = 'wice'

            withLabel: '.*gpu.*' {
                resourceLimits         = [ memory: 703.GB, cpus: 64, time: 168.h ]
                ext.vscCluster         = 'wice_gpu'
                apptainer.runOptions   = '--containall --cleanenv --nv'
                singularity.runOptions = '--containall --cleanenv --nv'
            }
        }
    }

    wice_gpu {
        params.config_profile_description = 'wice_gpu profile for use on the Wice cluster of the VSC HPC.'
        apptainer.runOptions              = '--containall --cleanenv --nv'
        singularity.runOptions            = '--containall --cleanenv --nv'

        process {
            resourceLimits = [ memory: 703.GB, cpus: 64, time: 168.h ]
            ext.vscCluster = 'wice_gpu'
        }
    }

    superdome {
        params.config_profile_description = 'superdome profile for use on the genius cluster of the VSC HPC.'

        process {
            // 6000 - 228 so 228GB for overhead, max is 5910888MB
            resourceLimits = [ memory: 5772.GB, cpus: 14, time: 168.h ]
            ext.vscCluster = 'superdome'
        }
    }
}
